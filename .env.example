# Public URL of the actual Caster.fm audio stream. Leave blank until you get it from Caster.fm.
NEXT_PUBLIC_RADIO_STREAM_URL=

# Optional public station page URL (for example, your Caster.fm station page).
NEXT_PUBLIC_STATION_URL=

# Free Caster.fm option: paste the public token shown in Widgets / Players.
# It enables Caster.fm's official embedded player without a Direct Stream Link.
NEXT_PUBLIC_CASTER_PUBLIC_TOKEN=
# Optional. Add the channel ID for a single-channel widget; leave blank to show available channels.
NEXT_PUBLIC_CASTER_CHANNEL_ID=

# Optional: only provide this if Caster.fm explicitly documents a public, browser-safe token.
NEXT_PUBLIC_CASTER_API_URL=
NEXT_PUBLIC_CASTER_API_TOKEN=
NEXT_PUBLIC_STATION_ID=

# Caster.fm public Icecast status. This gives the current track, listeners and
# the recent playlist without exposing a broadcaster password. The project has
# a working station default, so set these only if Caster.fm changes the host,
# port or mount point.
CASTER_STATUS_URL=
CASTER_MOUNT_POINT=
# Browser-safe alternatives, only if you need to expose the status address:
NEXT_PUBLIC_CASTER_STATUS_URL=
NEXT_PUBLIC_CASTER_MOUNT_POINT=

# Recommended server-only Caster.fm API configuration. These are used by /api/radio
# and are never sent to browser visitors. Paste the documented metadata/status endpoint here.
CASTER_API_URL=
CASTER_API_TOKEN=
CASTER_STATION_ID=

# Optional endpoint that receives a POST JSON request for a track request.
# Expected body: { name, artist, track, message }
NEXT_PUBLIC_REQUEST_TRACK_ENDPOINT=
